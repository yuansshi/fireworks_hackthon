# Copy to .env and fill in. Never commit .env.
FIREWORKS_API_KEY=
# Your Fireworks account id (shown by `firectl whoami` or in ~/.fireworks/auth.ini)
FIREWORKS_ACCOUNT_ID=
# Filled after scripts/deploy.sh: full model strings for the deployed LoRA adapters, e.g.
# accounts/<acct>/models/phish-nemotron-meta#accounts/<acct>/deployments/<dep-id>
FT_META_MODEL=
FT_TEXT_MODEL=
# Optional, only if Hugging Face rate-limits anonymous downloads
HF_TOKEN=
